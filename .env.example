# GDQ Rule Proposer — Environment Configuration
# Copy this file to .env.local, .env.dev, or .env.prod and fill in the values.

# Environment: local, dev, prod
GDQ_ENV=local

# === Athena (dev/prod only) ===
GDQ_ATHENA_REGION=
GDQ_ATHENA_WORKGROUP=
GDQ_ATHENA_S3_OUTPUT=
GDQ_AWS_PROFILE=

# === Mock (local only) ===
GDQ_MOCK_DATA_DIR=mock_data
