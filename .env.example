# GDQ Rule Proposer — Environment Configuration
# Copie para .env.local, .env.dev ou .env.prod e preencha.
#
# Uso: python run.py [--env local|dev|prod] [--mock] [--port 8501]
# Todos os ambientes usam Athena real por default.

# Environment: local, dev, prod
GDQ_ENV=local

# === Athena (todos os ambientes) ===
GDQ_ATHENA_REGION=us-east-1
GDQ_ATHENA_WORKGROUP=primary
GDQ_ATHENA_S3_OUTPUT=s3://seu-bucket/athena-results/
GDQ_AWS_PROFILE=seu-profile

# === Mock (apenas com --mock) ===
GDQ_MOCK_DATA_DIR=mock_data

# === Thundera / Glue DQ Test ===
GDQ_GLUE_JOB_NAME=glueplataformathundera
GDQ_GLUE_REGION=
GDQ_RACF=
GDQ_SQUAD=
GDQ_COMUNIDADE=
