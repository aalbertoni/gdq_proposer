# GDQ Rule Proposer — Environment Configuration
# Copie para .env e preencha.
#
# Uso: python run.py [--port 8501]

# === Athena ===
GDQ_ATHENA_REGION=us-east-1
GDQ_ATHENA_WORKGROUP=primary
GDQ_ATHENA_S3_OUTPUT=s3://seu-bucket/athena-results/
GDQ_AWS_PROFILE=seu-profile

# === Thundera / Glue DQ Test ===
GDQ_GLUE_JOB_NAME=glueplataformathundera
GDQ_GLUE_REGION=
GDQ_RACF=
GDQ_SQUAD=
GDQ_COMUNIDADE=
