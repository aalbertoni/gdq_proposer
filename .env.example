# ============================================================
# GDQ Rule Proposer — Configuracao de Ambiente
# ============================================================
#
# COMO USAR:
#   1. Copie este arquivo para .env:
#      Windows:    copy .env.example .env
#      Linux/Mac:  cp .env.example .env
#
#   2. Preencha os valores marcados como (obrigatorio)
#
#   3. Execute o app:
#      python launcher.py
#
# Ou use o wizard guiado que preenche automaticamente:
#   python setup_local.py
#
# ============================================================


# === AWS Profile (obrigatorio) ===
#
# Nome do profile configurado no AWS CLI.
# Para listar seus profiles: aws configure list-profiles
# Para criar um novo:        aws configure sso --profile meu-profile
#
GDQ_AWS_PROFILE=seu-profile


# === Athena — Regiao (tem default) ===
#
# Regiao AWS onde o Athena esta configurado.
# Default: sa-east-1
#
GDQ_ATHENA_REGION=sa-east-1


# === Athena — Workgroup (tem default) ===
#
# Workgroup do Athena.
# Default: analytics-workgroup-v3
#
GDQ_ATHENA_WORKGROUP=analytics-workgroup-v3


# === Athena — Bucket S3 de resultados (obrigatorio) ===
#
# Bucket S3 onde o Athena salva os resultados das queries.
# IMPORTANTE: deve terminar com /
#
# Formato: s3://itau-self-wkp-sa-east-1-{NUMERO_CONTA}/{SEU_RACF}/query_results/
#
# Para descobrir o numero da conta AWS:
#   aws sts get-caller-identity --profile seu-profile
#   (campo "Account")
#
# Exemplo: s3://itau-self-wkp-sa-east-1-123456789012/a12345/query_results/
#
GDQ_ATHENA_S3_OUTPUT=s3://itau-self-wkp-sa-east-1-CONTA/RACF/query_results/


# ============================================================
# Proxy corporativo (obrigatorio na rede Itau)
# ============================================================
#
# Formato: http://RACF:SENHA@proxynew.itau:8080
# Substitua RACF e SENHA pelos seus dados de rede.
#
# ATENCAO: se sua senha tiver caracteres especiais (@, #, !, etc),
# use encoding URL. Ex: @ = %40, # = %23, ! = %21
#
HTTP_PROXY=http://RACF:SENHA@proxynew.itau:8080
HTTPS_PROXY=http://RACF:SENHA@proxynew.itau:8080
http_proxy=http://RACF:SENHA@proxynew.itau:8080
https_proxy=http://RACF:SENHA@proxynew.itau:8080

# Enderecos que NAO passam pelo proxy (rede interna + AWS)
NO_PROXY=127.0.0.1,10.0.0.0/8,192.168.0.0/16,.aws.clud.ihf,.cloudera.site,.localhost,.cloud.ihf,*.corp.rc.itau,*.corp.ihf,*.itau.com,*.itau.corp.ihf,localhost
no_proxy=127.0.0.1,10.0.0.0/8,192.168.0.0/16,.aws.clud.ihf,.cloudera.site,.localhost,.cloud.ihf,*.corp.rc.itau,*.corp.ihf,*.itau.com,*.itau.corp.ihf,localhost


# ============================================================
# Abaixo: configuracoes opcionais (Thundera / Glue DQ Test)
# Preencha apenas se sua equipe usa o pipeline Thundera.
# ============================================================

# Nome do Glue job Thundera (geralmente nao muda)
GDQ_GLUE_JOB_NAME=glueplataformathundera

# Regiao do Glue (deixe vazio para usar a mesma do Athena)
GDQ_GLUE_REGION=

# Seu RACF (identificador pessoal)
GDQ_RACF=

# Nome da squad
GDQ_SQUAD=

# Nome da comunidade
GDQ_COMUNIDADE=
